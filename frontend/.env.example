# Base URL of the FastAPI backend.
BACKEND_URL=http://localhost:8000

# Canonical origin of this app. Used to build the links Supabase emails and the
# redirect after login or password reset. Required in production; in development
# the request origin is used when it is unset.
SITE_URL=http://localhost:3000

# Public URL of the MCP server, as agent clients reach it. Only used when the
# app is not served from localhost: the connect page derives
# http://<the-host-you-opened>:8001/mcp locally. Accepts the base URL or the
# full endpoint; `/mcp` is appended when it is missing.
MCP_URL=https://mcp.example.com

# Supabase project URL and publishable key (sb_publishable_...). Find them in the
# dashboard under Project Settings > API Keys. The publishable key replaces the
# legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Supabase secret key (sb_secret_...), same dashboard page. Replaces the legacy
# service_role key. Server-only: it bypasses RLS and the admin client uses it to
# delete a user's account. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Comma-separated list of enabled login methods: "email", "google".
# Supabase is the source of truth: a provider must also be enabled there.
NEXT_PUBLIC_AUTH_PROVIDERS=email

# Cloudinary cloud name the stock images are delivered from (the last segment of
# the dashboard's "cloud name", e.g. the one in your Cloudinary delivery URLs).
# The backend uploads there; the browser only reads. Optional: leave it empty and
# every image view falls back to the recipe its row was generated from.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Base URL of the Langfuse project the backend traces to, used for the "open the
# trace" link in the evidence panel. Optional: leave it empty and the panel shows
# the id with a copy button and nothing else. Build-time value: set it before
# `pnpm build`, not at runtime.
NEXT_PUBLIC_LANGFUSE_HOST=
