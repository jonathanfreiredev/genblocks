# Local development stack (docker-compose.yml).
#
# One of three environment files. The two apps read their own, and
# docker-compose.yml wants all three to exist before it starts:
#
#   cp .env.example .env
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env
#
# Adjust them after copying.
#
# Compose reads `.env` from this directory for variable substitution, so these
# values are what the containers use to reach Postgres. It is the source of
# truth for the database credentials.
#
# IMPORTANT: `backend/.env` needs a DATABASE_URL with the same password for runs
# made from the host (`uv run alembic upgrade head`, `uv run pytest`). The
# container is given the URL below by `docker-compose.yml`, so only host runs
# read backend/.env.

# Role and database the Postgres container creates.
POSTGRES_USER=postgres
POSTGRES_DB=mcpstack

# Required: docker-compose.yml has no default for it, so `docker compose up`
# fails loudly instead of silently picking one.
#
# Note that it is only applied the first time the volume is created. Changing it
# later means recreating the volume, which deletes the local data:
#
#   docker compose down -v
POSTGRES_PASSWORD=password
