# Environment: "production" (default) or "development" (enables SQL echo).
ENV=development

# Comma-separated browser origins allowed to call the API (CORS).
# Set your real frontend domain(s) in production.
CORS_ORIGINS=http://localhost:3000

# Minimum log level: DEBUG, INFO (default), WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# PostgreSQL connection string. Must use the asyncpg driver.
# For runs from the host, keep the password in step with the root `.env`, which
# is what docker-compose.yml uses to create the container.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mcpstack

# Supabase project URL. Access tokens are verified against
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://your-project-ref.supabase.co

# Audience claim carried by Supabase access tokens.
SUPABASE_JWT_AUDIENCE=authenticated

# Base URL of the frontend, used to build the links sent to the user.
FRONTEND_URL=http://localhost:3000

# Public URL of the MCP server, as its clients reach it. It is published in the
# OAuth discovery document, so it must be the URL clients use — not a
# container-internal hostname. See docker-compose.yml for the `mcp` service.
MCP_BASE_URL=http://localhost:8001

# Where this service reaches the MCP server as a client, which is what the
# playground does. Inside docker-compose the service answers to `mcp`, so compose
# overrides this with http://mcp:8001.
MCP_INTERNAL_URL=http://localhost:8001
