# This is the API and worker environment. The MCP service can run with the
# smaller set in `mcp.env.example`: it does not need Cloudinary, Modal, BFL,
# Voyage, Chroma or Langfuse credentials.

# Environment: "production" (default) or "development" (enables SQL echo).
ENV=development

# Comma-separated browser origins allowed to call the API (CORS).
# Set your real frontend domain(s) in production.
CORS_ORIGINS=http://localhost:3000

# Minimum log level: DEBUG, INFO (default), WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# PostgreSQL connection string. Must use the asyncpg driver.
# For runs from the host, keep the password in step with the root `.env`, which
# is what docker-compose.yml uses to create the container.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/genblocks

# Supabase project URL. Access tokens are verified against
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://your-project-ref.supabase.co

# Audience claim carried by Supabase access tokens.
SUPABASE_JWT_AUDIENCE=authenticated

# Base URL of the frontend, used to build the links sent to the user.
FRONTEND_URL=http://localhost:3000

# Public URL of the MCP server, as its clients reach it. It is published in the
# OAuth discovery document, so it must be the URL clients use — not a
# container-internal hostname. See docker-compose.yml for the `mcp` service.
MCP_BASE_URL=http://localhost:8001

# Where this service reaches the MCP server as a client, which is what the
# playground does. Inside docker-compose the service answers to `mcp`, so compose
# overrides this with http://mcp:8001.
MCP_INTERNAL_URL=http://localhost:8001

# The Modal function that drains the task queue, named as "app.function" — the
# deployed value is `genblocks-worker.drain`. The API wakes it the moment a task
# is queued, and it runs the same entrypoint as `python -m app.tasks.worker`.
# Left empty in development, where this process owns the worker itself. The
# worker's own environment is `worker.env.example`, not this file.
WORKER_FUNCTION=

# --- Generation providers ---------------------------------------------------
# Server-only keys. Never exposed to the frontend, and never handed to the
# sandbox.

# OpenAI: conversational agent, spec, harness and judge.
OPENAI_API_KEY=your_openai_api_key_here

# Black Forest Labs: generates the decorative images used inside blocks (FLUX.2).
# The API is asynchronous: the backend polls until the image is ready, then
# re-hosts it. Generated images may not contain people.
BFL_API_KEY=your_bfl_api_key_here
# The hosts BFL may name in a polling URL or a finished sample URL. The backend
# refuses anything else rather than fetching a provider-supplied address.
BFL_ASSET_HOSTS=delivery.bfl.ai,api.bfl.ai

# Groq: text-moderation fallback when OPENAI_API_KEY is not set.
GROQ_API_KEY=your_groq_api_key_here

# OpenAI moderation (text and images; free, images up to 20 MB). The key above is
# also used here; the moderation model is an endpoint, not a chat model, and is
# never the same call that writes or judges a block.
OPENAI_MODERATION_MODEL=omni-moderation-latest

# The visual no-people gate and the image-direction policy for component briefs
# and standalone prompts. They are separate from omni-moderation: one asks
# whether a human is present, the other decides whether the person asked for one.
# Both use the OpenAI key above.
PEOPLE_DETECTION_MODEL=gpt-4o-mini
IMAGE_DIRECTION_MODEL=gpt-4o-mini

# Every image is decoded, bounded and re-encoded before moderation or storage.
IMAGE_MAX_BYTES=20971520
IMAGE_MAX_PIXELS=24000000
IMAGE_REENCODE_QUALITY=85

# Global operators who may review reports and take content down. Comma-separated
# emails. This is not an organization role: an owner of one tenant cannot remove
# another tenant's public work.
ADMIN_EMAILS=

# Resend: a notification email when a report enters the queue. The report is
# saved even if Resend is down or unconfigured; this is not a moderation gate.
RESEND_API_KEY=
# Must be a sender/domain verified in Resend in production.
RESEND_FROM_EMAIL="GenBlocks <onboarding@resend.dev>"
# Where notifications go. Empty falls back to ADMIN_EMAILS.
REPORT_NOTIFICATION_EMAILS=

# Voyage: embeddings for retrieval.
VOYAGE_API_KEY=your_voyage_api_key_here

# Cloudinary: stores generated images and screenshots, nothing goes to disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Modal: runs the code sandbox. It is secret-free; these tokens only let the
# backend reach it.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Chroma: retrieval vectors. Left blank in development it uses a local client;
# set all four for Chroma Cloud in production.
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=genblocks

# Langfuse: optional tracing. Without both keys nothing is sent and every trace
# id stays null; the trace is a copy of the run, never the ledger. Scores and task
# state live in Postgres.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional overrides for the generation loop (defaults shown).
# LLM_MODEL=gpt-6-luna
# IMAGE_MODEL=flux-2-pro
# MODERATION_MODEL=openai/gpt-oss-safeguard-20b
# PEOPLE_DETECTION_MODEL=gpt-4o-mini
# IMAGE_DIRECTION_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=voyage-multimodal-3
# MAX_ATTEMPTS=2
