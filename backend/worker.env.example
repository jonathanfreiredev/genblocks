# Environment for the task worker only: the Modal function in
# `app/tasks/modal_app.py` that drains the queue.
#
# It is not the API's file and not the MCP's. The worker builds blocks, judges
# them and files the pictures, so it needs the generation providers, the storage
# and the retrieval store — everything `backend/.env.example` lists, minus the
# settings that belong to serving requests (`CORS_ORIGINS`, `MCP_*`,
# `WORKER_FUNCTION`).
#
# Copy it to `worker.env` and upload it once:
#
#     cp worker.env.example worker.env   # then fill in the values
#     modal secret create genblocks-worker --from-dotenv worker.env
#
# `worker.env` holds production credentials and is ignored by git and by Docker.
# Use `--force` on the command above to replace an existing secret.
#
# Where a setting is also read by the API, both have to carry the same value: a
# block's score is only comparable with the next one if the model, the rubric
# wording and the distances were the same when each was produced.

ENV=production
LOG_LEVEL=INFO

# PostgreSQL. The worker writes every step of a run, so this role needs the task
# tables and the catalogue, the same as the API's.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/genblocks

# Supabase project, for the same token verification the API does. The worker does
# not serve requests, but it reads the user a task belongs to.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Used in the links the policy notifications carry.
FRONTEND_URL=https://genblocks.jonathanfreire.com

# --- Generation providers ---------------------------------------------------
# Server-only keys. They are handed to no sandbox and no browser.

OPENAI_API_KEY=your_openai_api_key_here
BFL_API_KEY=your_bfl_api_key_here
BFL_ASSET_HOSTS=delivery.bfl.ai,api.bfl.ai
BFL_ALLOWED_DOMAINS=bfl.ai
GROQ_API_KEY=your_groq_api_key_here

OPENAI_MODERATION_MODEL=omni-moderation-latest
PEOPLE_DETECTION_MODEL=gpt-4o-mini
IMAGE_DIRECTION_MODEL=gpt-4o-mini

# --- Storage, retrieval and tracing -----------------------------------------

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

VOYAGE_API_KEY=your_voyage_api_key_here

# All four, or it falls back to a local directory that does not exist here.
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=genblocks

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- The sandbox ------------------------------------------------------------
# The worker reaches the harness the same way the API does, and it runs inside
# Modal while calling it. If a run inside Modal cannot borrow the workspace's
# credentials, these two are what it needs.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Operators --------------------------------------------------------------

ADMIN_EMAILS=
RESEND_API_KEY=
RESEND_FROM_EMAIL="GenBlocks <onboarding@resend.dev>"
REPORT_NOTIFICATION_EMAILS=

# --- Loop settings ----------------------------------------------------------
# These have defaults in `app/settings.py`; they are listed because the ones
# shared with the API must agree, and because changing one changes the version
# stamped on future runs.

TASKS_PER_MONTH=10

