# Environment for the MCP service only.
#
# This is deliberately smaller than backend/.env. The MCP server builds no
# components, renders no pages and deletes no media: it reads the public vault,
# queues tasks through the same domain services, and sends the operator a policy
# notice. It does not need the Cloudinary, Modal, BFL, Voyage, Chroma or Langfuse
# credentials. Keep them out of this process so a compromise of the agent-facing
# door cannot reach the rest of the deployment.
#
# Use a database role that can read the vault and write the task rows the tools
# create; it does not need the operator or deletion permissions.

ENV=production
LOG_LEVEL=INFO

# PostgreSQL. The MCP writes tasks, so this role needs INSERT/UPDATE on the task
# tables in addition to reading the public catalogue and profiles.
DATABASE_URL=postgresql+asyncpg://genblocks_mcp:password@localhost:5432/genblocks

# Supabase project that issues the access tokens. The issuer and JWKS endpoint
# are derived from this URL.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Public URL of this MCP server, as OAuth clients reach it. Published in the
# protected-resource metadata, so it must be the real HTTPS address, not a
# container-internal hostname.
MCP_BASE_URL=https://mcp.example.com

# Used in the links the policy notification emails carry.
FRONTEND_URL=https://app.example.com

# Text moderation and the image-direction policy. Without an OpenAI or Groq key
# production moderation fails closed, so the tools refuse to queue work.
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_MODEL=openai/gpt-oss-safeguard-20b
IMAGE_DIRECTION_MODEL=gpt-4o-mini

# The same monthly allowance as the API, or the two doors would disagree about
# what a person has left.
TASKS_PER_MONTH=10

# Policy notices. Optional: the report/task row is committed either way.
RESEND_API_KEY=
RESEND_FROM_EMAIL="GenBlocks <onboarding@resend.dev>"
ADMIN_EMAILS=
REPORT_NOTIFICATION_EMAILS=
